{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flow",
  "scopeName": "source.flow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#live-variables" },
    { "include": "#step-loop" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#builtin-methods" },
    { "include": "#function-declaration" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.flow",
          "match": "//.*$"
        },
        {
          "name": "comment.block.flow",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flow",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flow",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.flow",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.flow",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.flow",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?[fF]?\\b|\\b[0-9]+[fF]\\b"
        },
        {
          "name": "constant.numeric.integer.flow",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "live-variables": {
      "patterns": [
        {
          "match": "\\b(live)\\s*(\\[)\\s*([0-9]+)\\s*(\\])\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.live.flow keyword.control.live.flow markup.changed.git_rebase" },
            "2": { "name": "punctuation.bracket.square.flow" },
            "3": { "name": "constant.numeric.integer.live-limit.flow markup.changed.git_rebase" },
            "4": { "name": "punctuation.bracket.square.flow" },
            "5": { "name": "entity.name.variable.live.flow markup.changed.git_rebase" }
          }
        },
        {
          "match": "\\b(live)\\s+([0-9]+)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.live.flow keyword.control.live.flow markup.changed.git_rebase" },
            "2": { "name": "constant.numeric.integer.live-limit.flow markup.changed.git_rebase" },
            "3": { "name": "entity.name.variable.live.flow markup.changed.git_rebase" }
          }
        },
        {
          "match": "\\b(live)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.live.flow keyword.control.live.flow markup.changed.git_rebase" },
            "2": { "name": "entity.name.variable.live.flow markup.changed.git_rebase" }
          }
        },
        {
          "name": "storage.type.live.flow keyword.control.live.flow markup.changed.git_rebase",
          "match": "\\b(live)\\b"
        }
      ]
    },
    "step-loop": {
      "patterns": [
        {
          "match": "\\b(step)\\s*(\\[)\\s*([0-9]+)\\s*(\\])",
          "captures": {
            "1": { "name": "keyword.control.step.flow" },
            "2": { "name": "punctuation.bracket.square.flow" },
            "3": { "name": "constant.numeric.integer.step-limit.flow" },
            "4": { "name": "punctuation.bracket.square.flow" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow",
          "match": "\\b(if|elif|else|match|while|step|for|in|return)\\b"
        },
        {
          "name": "keyword.declaration.flow",
          "match": "\\b(fn|inner|var|val|live|class)\\b"
        },
        {
          "name": "keyword.other.flow",
          "match": "\\b(this|new)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.flow",
          "match": "\\b(print|len|str|toInt|input|type|isExpired)\\b"
        }
      ]
    },
    "builtin-methods": {
      "patterns": [
        {
          "name": "support.function.method.builtin.flow",
          "match": "\\b(trim|split|replace|contains|startsWith|endsWith|abs|round|ceil|floor|clamp|pop|join|slice|push|length)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.flow",
          "match": "\\b(Int|Double|Float|String|Boolean|Short|Byte|Void)\\b"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.declaration.flow" },
            "2": { "name": "entity.name.function.flow" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.flow",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.fat-arrow.flow",
          "match": "=>"
        },
        {
          "name": "keyword.operator.range.flow",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.logical.flow",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.flow",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.flow",
          "match": "\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.arithmetic.flow",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.dot.flow",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.flow",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.flow",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.flow",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.flow",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.braces.flow",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.flow",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
