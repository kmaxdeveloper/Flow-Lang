{
  "Flow Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:param}: ${3:Type}): ${4:Void} {",
      "    ${0}",
      "}"
    ],
    "description": "Flow funksiyasi e'loni"
  },
  "Flow Expression Function": {
    "prefix": "fnx",
    "body": [
      "fn ${1:name}(${2:param}: ${3:Type}): ${4:Type} => ${0}"
    ],
    "description": "Flow expression-body funksiyasi (=> operator)"
  },
  "Flow Inner Function": {
    "prefix": "inner",
    "body": [
      "inner fn ${1:name}(${2:param}: ${3:Type}): ${4:Void} {",
      "    ${0}",
      "}"
    ],
    "description": "Flow ichki funksiyasi e'loni"
  },
  "Flow Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}(var ${2:field}: ${3:String}) {",
      "    fn ${4:method}() {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Flow klass e'loni (Primary Constructor bilan)"
  },
  "Flow Class Full": {
    "prefix": "classf",
    "body": [
      "class ${1:Name}(var ${2:field1}: ${3:String}, var ${4:field2}: ${5:Int}) {",
      "    fn greet() {",
      "        print(\"Salom! Men \" + this.${2:field1})",
      "    }",
      "",
      "    fn ${6:method}(): ${7:Void} {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Flow klass to'liq shablon"
  },
  "Flow Main Function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "    ${0}",
      "}"
    ],
    "description": "Flow main() funksiyasi"
  },
  "Flow Var Declaration": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${0}"
    ],
    "description": "O'zgaruvchi e'loni (var)"
  },
  "Flow Val Declaration": {
    "prefix": "val",
    "body": [
      "val ${1:name} = ${0}"
    ],
    "description": "O'zgarmas qiymat e'loni (val)"
  },
  "Flow Live Variable (Default 3)": {
    "prefix": "live",
    "body": [
      "live ${1:name} = ${0:value}"
    ],
    "description": "Flow live o'zgaruvchi (default limit 3)"
  },
  "Flow Live Variable with Limit": {
    "prefix": "liven",
    "body": [
      "live ${1:limit} ${2:name} = ${0:value}"
    ],
    "description": "Flow live N o'zgaruvchi (aniq limit bilan)"
  },
  "Flow Step While Loop": {
    "prefix": "stepw",
    "body": [
      "step[${1:3}] while (${2:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "Flow step while sikli (limit bilan)"
  },
  "Flow If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "Flow if sharti"
  },
  "Flow If-Else Statement": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "    ${2}",
      "} else {",
      "    ${0}",
      "}"
    ],
    "description": "Flow if-else sharti"
  },
  "Flow If-Elif-Else Statement": {
    "prefix": "ifee",
    "body": [
      "if (${1:condition}) {",
      "    ${2}",
      "} elif (${3:condition2}) {",
      "    ${4}",
      "} else {",
      "    ${0}",
      "}"
    ],
    "description": "Flow if-elif-else sharti"
  },
  "Flow Match On Value Expression": {
    "prefix": "match",
    "body": [
      "match (${1:expr}) {",
      "    ${2:pattern1} => ${3:result1},",
      "    ${4:pattern2} => ${5:result2},",
      "    else => ${0:default}",
      "}"
    ],
    "description": "Flow match qiymat bo'yicha ifodasi"
  },
  "Flow Match Conditions Expression": {
    "prefix": "matchc",
    "body": [
      "match {",
      "    ${1:condition1} => ${2:result1},",
      "    ${3:condition2} => ${4:result2},",
      "    else => ${0:default}",
      "}"
    ],
    "description": "Flow match shartlar bo'yicha ifodasi"
  },
  "Flow While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "Flow while sikli"
  },
  "Flow For-In Loop": {
    "prefix": "for",
    "body": [
      "for (${1:item} in ${2:collection}) {",
      "    ${0}",
      "}"
    ],
    "description": "Flow for-in sikli"
  },
  "Flow For Range Loop": {
    "prefix": "forr",
    "body": [
      "for (${1:i} in ${2:0}..${3:10}) {",
      "    ${0}",
      "}"
    ],
    "description": "Flow for diapazon sikli (0..N)"
  },
  "Flow Return": {
    "prefix": "return",
    "body": [
      "return ${0}"
    ],
    "description": "Flow return iborasi"
  },
  "Flow Print": {
    "prefix": "print",
    "body": [
      "print(${0})"
    ],
    "description": "Konsolga chiqarish"
  },
  "Flow New Object": {
    "prefix": "new",
