  },
  "Flow String Type Annotation": {
    "prefix": "String",
    "body": ["String"],
    "description": "String turi"
  },
  "Flow Int Type Annotation": {
    "prefix": "Int",
    "body": ["Int"],
    "description": "Int turi"
  },
  "Flow Boolean Type Annotation": {
    "prefix": "Boolean",
    "body": ["Boolean"],
    "description": "Boolean turi"
  },
  "Flow isExpired Function": {
    "prefix": "isExpired",
    "body": [
      "isExpired(${1:variable})"
    ],
    "description": "Live o'zgaruvchi muddati tugaganini tekshirish"
  },
